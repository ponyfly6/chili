{
  "name": "chili",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "check": "bun run typecheck",
    "cli": "bun run apps/cli/src/index.ts",
    "chili": "bun run apps/cli/src/index.ts",
    "desktop": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build",
    "desktop:package": "bun run --cwd apps/desktop package:mac",
    "desktop:package:dir": "bun run --cwd apps/desktop package:dir",
    "desktop:preview": "bun run scripts/desktop-preview.ts",
    "test:e2e:desktop": "bun run --cwd apps/desktop test:e2e",
    "smoke:desktop": "bun run scripts/smoke-desktop.ts",
    "smoke:desktop-projects": "bun run scripts/smoke-desktop-projects.ts",
    "tui": "bun run apps/tui/src/index.tsx",
    "probe:minimax": "bun run scripts/probe-minimax.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:all": "bun run scripts/smoke-all.ts",
    "smoke:p0": "bun run scripts/smoke.ts",
    "smoke:cli": "bun run scripts/smoke-cli.ts",
    "smoke:p0p1": "bun run scripts/smoke-p0-p1.ts",
    "smoke:p2": "bun run scripts/smoke-p2-subagent.ts",
    "smoke:p2-control": "bun run scripts/smoke-p2-task-control.ts",
    "smoke:p3": "bun run scripts/smoke-p3-agent-tree.ts",
    "smoke:p3-background": "bun run scripts/smoke-p3-background.ts",
    "smoke:p3-multi-agent-lifecycle": "bun run scripts/smoke-p3-multi-agent-lifecycle.ts",
    "smoke:p3-team-model": "bun run scripts/smoke-p3-team-model.ts",
    "smoke:p3-team-parallel": "bun run scripts/smoke-p3-team-parallel.ts",
    "test:index": "bun run scripts/test-index.ts",
    "eval:coding": "bun run scripts/coding-eval/index.ts",
    "typecheck": "tsc -b && bun run --cwd apps/desktop typecheck && bun run --cwd apps/control-web typecheck",
    "control-web:build": "bun run --cwd apps/control-web build",
    "control-web:typecheck": "bun run --cwd apps/control-web typecheck",
    "test:e2e:remote": "bun run --cwd apps/desktop typecheck:e2e && bun run apps/desktop/e2e/remote-control.e2e.ts"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "body-parser": "2.3.0",
    "diff": "8.0.3",
    "fast-uri": "4.1.3",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "qs": "6.15.2",
    "shell-quote": "1.9.0",
    "undici": "7.29.0",
    "ws": "8.21.0"
  }
}

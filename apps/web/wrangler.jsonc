{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chili-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}

{
  "name": "@chili/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chili companion for iOS and Android with bundled control UI",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src",
    "test:ios": "node scripts/test-ios.mjs",
    "native:init": "node scripts/init-native.mjs",
    "sync": "bun run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@chili/control-web": "workspace:*",
    "@chili/remote-control": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.8.3",
    "vite": "7.3.6"
  }
}
